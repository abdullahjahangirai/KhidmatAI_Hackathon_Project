# ===============================================
# KhidmatAI Environment Configuration
# ===============================================

# 1. Primary AI Provider: Google Gemini API
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# 2. Secondary AI Provider: Groq Cloud API (Instant Fallback)
# Get key: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Web Search Provider: Tavily AI Search (Dynamic Welfare Program Discovery)
# Get key: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# 4. Optional / Legacy AI Provider: Alibaba Cloud DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# App Name
APP_NAME=KhidmatAI

