# ===============================================
# KhidmatAI Environment Configuration
# ===============================================
# Copy this file to .env and fill in your keys.

# 1. Primary AI: Google Gemini API
#    Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# 2. Secondary AI: Alibaba Cloud Model Studio (DashScope / Qwen)
#    Endpoint: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#    Get key: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# DashScope model fallback chain (tried in order):
#   Primary   → qwen3.7-plus
#   Secondary → qwen3.6-plus
#   Tertiary  → qwen3.6-flash

# 3. Fallback AI: Groq Cloud API
#    Get key: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# 4. Web Search: Tavily AI Search (optional, for dynamic welfare discovery)
#    Get key: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# App Name
APP_NAME=KhidmatAI
